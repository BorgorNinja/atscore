generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" and a DATABASE_URL for production (e.g. Neon, Supabase).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?
  createdAt     DateTime @default(now())
  scans         ResumeScan[]
}

model ResumeScan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeFilename  String
  jobTitle        String?
  score           Int
  matchedKeywords String   // JSON-encoded string[]
  missingKeywords String   // JSON-encoded string[]
  suggestions     String   // JSON-encoded string[]
  createdAt       DateTime @default(now())

  @@index([userId])
}
